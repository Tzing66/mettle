{
  "version": "benchmarks.v1",
  "_sources": {
    "lifts": "Strength Level bodyweight-ratio standards (strengthlevel.com/strength-standards), accessed 2026-10-07. Tiers are percentile-defined: Beginner > 5% of lifters, Novice > 20%, Intermediate > 50%, Advanced > 80%, Elite > 95%. Based on ~10.9M qualifying community lifts. Cross-checked against Trainnode's coach reference ratios (Intermediate within 0.25x).",
    "reps": "Strength Level whole-community rep standards for push-ups and pull-ups, accessed 2026-10-07. '<1' is stored as 1 (the first rep).",
    "running": "Age grade = WMA/USATF 2025 road age standard for the runner's age and sex / their time (config/age-grading.road2025.json, CC0). Tiers 40/50/60/70/80% place Intermediate at WAVA 'local class' (60%), Advanced at 'regional class' (70%), Elite at 'national class' (80%)."
  },
  "tiers": ["beginner", "novice", "intermediate", "advanced", "elite"],
  "benchmarks": [
